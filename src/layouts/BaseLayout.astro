---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/500.css";
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import ParticleYMark from "../components/ParticleYMark.astro";
import AntigravityField from "../components/AntigravityField.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "YARQ — Infraestructura digital para construir el futuro",
  description = "Digitalizamos lo esencial para construir un futuro mejor: plataformas, automatización e inteligencia artificial sobre una arquitectura compartida.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const canonical = new URL(path.replace(/\/$/, "") + "/", Astro.site).href;
const ogImage = new URL("logo.svg", new URL(base, Astro.site)).href;

function isCurrent(href: string) {
  if (href === base || href === `${base}`) return path === base || path === `${base}` || path === "/";
  return path.startsWith(href);
}

const isHome = path === base || path === `${base}` || path === "/" || path === `${base}index.html`;

const nav = [
  { href: `${base}#yarq`, label: "Nosotros", icon: "sigil" },
  { href: `${base}#capacidades`, label: "Servicios", icon: "iso" },
  { href: `${base}#productos`, label: "Productos", icon: "matrix" },
  { href: `${base}apps/`, label: "Catálogo", icon: "index", page: true },
];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#edf2f7" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="YARQ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="lab-field" aria-hidden="true">
      <span class="lab-aurora lab-aurora--a"></span>
      <span class="lab-aurora lab-aurora--b"></span>
      <span class="lab-aurora lab-aurora--c"></span>
      <span class="lab-aurora lab-aurora--d"></span>
      <span class="lab-stars"></span>
      <span class="lab-orbit"></span>
      <span class="lab-mesh"></span>
    </div>
    <AntigravityField />
    {!isHome && (
    <header class="site-header">
      <div class="wrap nav-wrap">
        <div class="nav nav--pill">
          <a class="brand brand--icon-only" href={base} aria-label="YARQ — Inicio">
            <ParticleYMark isHome={isHome} />
          </a>
          <nav aria-label="Principal">
            <ul class="nav-links">
              {
                nav.map((item) => (
                  <li>
                    <a
                      class="nav-link"
                      href={item.href}
                      aria-current={item.page && isCurrent(`${base}apps/`) ? "page" : undefined}
                    >
                      <svg class="nav-ico" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        {item.icon === "sigil" && (
                          <>
                            <circle cx="10" cy="10" r="7.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 2.2" />
                            <polygon points="10,4.5 14.8,13 5.2,13" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
                            <circle cx="10" cy="10.2" r="1.4" fill="var(--nav-accent, #7c3aed)" />
                          </>
                        )}
                        {item.icon === "iso" && (
                          <>
                            <polygon points="10,2.4 16.8,6.2 10,10 3.2,6.2" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
                            <path d="M3.2 6.2v6.6L10 16.6l6.8-3.8V6.2M10 10v6.6" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
                            <circle cx="10" cy="6.2" r="1.1" fill="var(--nav-accent, #06b6d4)" />
                          </>
                        )}
                        {item.icon === "matrix" && (
                          <>
                            <rect x="3.2" y="3.2" width="5.4" height="5.4" rx="1.4" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.3" />
                            <rect x="11.4" y="3.2" width="5.4" height="5.4" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.3" />
                            <rect x="3.2" y="11.4" width="5.4" height="5.4" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.3" />
                            <rect x="11.4" y="11.4" width="5.4" height="5.4" rx="1.4" fill="var(--nav-accent, #7c3aed)" fill-opacity="0.28" stroke="var(--nav-accent, #7c3aed)" stroke-width="1.3" />
                          </>
                        )}
                        {item.icon === "index" && (
                          <>
                            <circle cx="4.8" cy="5.5" r="1.4" fill="var(--nav-accent, #06b6d4)" />
                            <path d="M8.5 5.5h8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            <circle cx="4.8" cy="10" r="1.4" fill="currentColor" />
                            <path d="M8.5 10h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                            <circle cx="4.8" cy="14.5" r="1.4" fill="var(--nav-accent, #7c3aed)" />
                            <path d="M8.5 14.5h8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                          </>
                        )}
                      </svg>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>
    )}
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p>
            <strong>YARQ</strong> — estudio de productos digitales, sistemas y
            automatización en producción. Documentación pública sin exponer
            rutas internas ni secretos.
          </p>
          <p class="footer-meta">
            Repositorio público:
            <a href="https://github.com/felipebarraza6/yggdra-web" target="_blank" rel="noreferrer">yggdra-web</a>
            {" · "}
            <a href={`${base}apps/`}>Catálogo completo</a>
            {" · "}
            <a href={`${base}modulos/`}>Módulos API</a>
          </p>
        </div>
        <p class="credit-foot">YARQ</p>
      </div>
    </footer>
    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce) {
        const els = document.querySelectorAll(".reveal");
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-in");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.1 }
        );
        els.forEach((el) => io.observe(el));

        // Rastreo de puntero para revelación de energía negativa en paneles interactivos
        document.querySelectorAll<HTMLElement>(".glass--interactive, .cta-band--space").forEach((el) => {
          el.addEventListener(
            "pointermove",
            (ev) => {
              const r = el.getBoundingClientRect();
              el.style.setProperty("--mx", `${ev.clientX - r.left}px`);
              el.style.setProperty("--my", `${ev.clientY - r.top}px`);
            },
            { passive: true }
          );
        });
      } else {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-in"));
      }
    </script>
  </body>
</html>
