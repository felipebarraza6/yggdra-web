---
/** Marca hero: Y con órbitas, nodos y energía espacial. */
---

<div class="hero-mark" aria-hidden="true">
  <div class="hero-mark__glow"></div>
  <div class="hero-mark__ring hero-mark__ring--a"></div>
  <div class="hero-mark__ring hero-mark__ring--b"></div>
  <div class="hero-mark__ring hero-mark__ring--c"></div>
  <div class="hero-mark__floor"></div>
  <svg class="hero-mark__y" viewBox="0 0 200 220" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="heroYStroke" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#148a98"></stop>
        <stop offset="55%" stop-color="#0d6e7a"></stop>
        <stop offset="100%" stop-color="#0f1c22"></stop>
      </linearGradient>
      <filter id="heroSoft" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#0d6e7a" flood-opacity="0.28"></feDropShadow>
      </filter>
    </defs>
    <g class="hero-mark__guides" stroke="#7aa3ab" stroke-width="0.8" opacity="0.45">
      <line x1="20" y1="200" x2="100" y2="28"></line>
      <line x1="180" y1="200" x2="100" y2="28"></line>
      <line x1="40" y1="200" x2="100" y2="70"></line>
      <line x1="160" y1="200" x2="100" y2="70"></line>
    </g>
    <path
      class="hero-mark__path"
      d="M36 36 L100 118 L164 36 M100 118 V196"
      fill="none"
      stroke="url(#heroYStroke)"
      stroke-width="14"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#heroSoft)"
    ></path>
    <circle class="hero-mark__node n1" cx="36" cy="36" r="7" fill="#148a98"></circle>
    <circle class="hero-mark__node n2" cx="164" cy="36" r="7" fill="#148a98"></circle>
    <circle class="hero-mark__node n3" cx="100" cy="118" r="9" fill="#0f1c22"></circle>
    <circle class="hero-mark__node n4" cx="100" cy="196" r="6.5" fill="#5a8a94"></circle>
  </svg>
  <span class="hero-mark__spark s1"></span>
  <span class="hero-mark__spark s2"></span>
  <span class="hero-mark__spark s3"></span>
</div>

<style>
  .hero-mark {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }

  .hero-mark__glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 45%, rgba(20, 138, 152, 0.28), transparent 62%),
      radial-gradient(circle at 60% 70%, rgba(15, 28, 34, 0.12), transparent 55%);
    filter: blur(8px);
    animation: glow-breathe 5.5s ease-in-out infinite;
  }

  .hero-mark__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, #0d6e7a 35%, transparent);
    inset: 8%;
  }

  .hero-mark__ring--a {
    animation: orbit-spin 28s linear infinite;
    border-style: solid;
  }

  .hero-mark__ring--b {
    inset: 18%;
    border-style: dashed;
    border-color: color-mix(in srgb, #1a3f4a 28%, transparent);
    animation: orbit-spin-rev 38s linear infinite;
  }

  .hero-mark__ring--c {
    inset: 28%;
    border-color: color-mix(in srgb, #148a98 40%, transparent);
    animation: orbit-pulse 4.5s ease-in-out infinite;
  }

  .hero-mark__floor {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 6%;
    height: 28%;
    background: linear-gradient(180deg, transparent, rgba(13, 110, 122, 0.08));
    clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%);
    border-bottom: 1px solid rgba(13, 110, 122, 0.2);
  }

  .hero-mark__y {
    position: relative;
    z-index: 2;
    width: 68%;
    height: auto;
  }

  .hero-mark__path {
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    animation: y-draw 1.6s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
  }

  .hero-mark__guides {
    opacity: 0;
    animation: fade-in 0.9s ease 0.1s forwards;
  }

  .hero-mark__node {
    opacity: 0;
    transform-origin: center;
    animation: node-pop 0.55s ease forwards;
  }

  .hero-mark__node.n1 {
    animation-delay: 1.15s;
  }
  .hero-mark__node.n2 {
    animation-delay: 1.25s;
  }
  .hero-mark__node.n3 {
    animation-delay: 1.35s;
  }
  .hero-mark__node.n4 {
    animation-delay: 1.45s;
  }

  .hero-mark__spark {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #148a98;
    box-shadow: 0 0 16px rgba(20, 138, 152, 0.65);
    z-index: 3;
  }

  .hero-mark__spark.s1 {
    top: 22%;
    left: 18%;
    animation: spark-float 4.2s ease-in-out infinite;
  }
  .hero-mark__spark.s2 {
    top: 30%;
    right: 16%;
    width: 6px;
    height: 6px;
    animation: spark-float 5s ease-in-out 0.6s infinite;
  }
  .hero-mark__spark.s3 {
    bottom: 26%;
    left: 28%;
    width: 5px;
    height: 5px;
    background: #0f1c22;
    animation: spark-float 4.8s ease-in-out 1s infinite;
  }

  @keyframes y-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade-in {
    to {
      opacity: 0.45;
    }
  }
  @keyframes node-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes orbit-spin-rev {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes orbit-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.55;
    }
    50% {
      transform: scale(1.04);
      opacity: 0.9;
    }
  }
  @keyframes glow-breathe {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @keyframes spark-float {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateY(-10px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark__path,
    .hero-mark__guides,
    .hero-mark__node,
    .hero-mark__ring,
    .hero-mark__glow,
    .hero-mark__spark {
      animation: none !important;
    }
    .hero-mark__path {
      stroke-dashoffset: 0;
    }
    .hero-mark__guides,
    .hero-mark__node {
      opacity: 1;
    }
  }
</style>
