---
const steps = [
  { id: "1", label: "PR", sub: "cambio en la plataforma" },
  { id: "2", label: "CI", sub: "validación automática" },
  { id: "3", label: "Impacto", sub: "reporte por app" },
  { id: "4", label: "Ajustes", sub: "contrato / UI" },
  { id: "5", label: "Promoción", sub: "coordinada" },
  { id: "6", label: "Deploy", sub: "continuo" },
];
---

<div class="diagram-wrap glass panel flow-wrap">
  <svg class="diagram" viewBox="0 0 900 160" role="img" aria-labelledby="flow-title">
    <title id="flow-title">Flujo de un cambio: PR, CI, impacto, ajustes, promoción y deploy</title>
    {
      steps.map((s, i) => {
        const x = 30 + i * 145;
        const next = i < steps.length - 1;
        return (
          <g>
            <rect class="node-strong" x={x} y="40" width="120" height="70" rx="14" />
            <text x={x + 60} y="70" text-anchor="middle" font-size="14" font-weight="600">{s.label}</text>
            <text class="muted" x={x + 60} y="92" text-anchor="middle" font-size="11">{s.sub}</text>
            {next && (
              <path
                class="edge"
                d={`M${x + 122} 75 L${x + 143} 75`}
                marker-end="url(#arrow)"
              />
            )}
          </g>
        );
      })
    }
    <defs>
      <marker id="arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
        <path d="M0,0 L6,3 L0,6 Z" fill="#2f6f66"></path>
      </marker>
    </defs>
  </svg>
  <ol class="visually-hidden">
    {steps.map((s) => <li>{s.label}: {s.sub}</li>)}
  </ol>
</div>
