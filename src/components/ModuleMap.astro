---
interface Consumer {
  id: string;
  name: string;
  product?: string;
  company?: string;
  status: string;
  statusLabel: string;
  modules: string[];
}

interface Props {
  consumers: Consumer[];
  modules: string[];
  base?: string;
}

const { consumers, modules, base = import.meta.env.BASE_URL } = Astro.props;
const payload = JSON.stringify({ consumers, modules, base });
---

<div class="map-root" data-map={payload}>
  <div class="map-toolbar">
    <div class="view-toggle" role="group" aria-label="Tipo de vista">
      <button type="button" data-view="matrix" aria-pressed="true">Matriz</button>
      <button type="button" data-view="graph" aria-pressed="false">Grafo</button>
    </div>
    <label>
      Filtrar app
      <input type="search" data-filter placeholder="Nombre o cliente…" autocomplete="off" />
    </label>
    <label>
      Estado
      <select data-status>
        <option value="">Todos</option>
        <option value="activa">Activa</option>
        <option value="en migración">En migración</option>
        <option value="legado">Legado</option>
      </select>
    </label>
  </div>

  <div class="matrix-wrap glass" data-panel="matrix" role="region" aria-label="Matriz apps y módulos" tabindex="0">
    <table class="matrix">
      <thead>
        <tr>
          <th scope="col">App</th>
          {modules.map((m) => <th scope="col">{m}</th>)}
        </tr>
      </thead>
      <tbody data-matrix-body></tbody>
    </table>
  </div>

  <div class="graph-wrap glass hidden" data-panel="graph" role="region" aria-label="Grafo apps y módulos">
    <svg data-graph viewBox="0 0 920 480" role="img" aria-labelledby="graph-title">
      <title id="graph-title">Relación entre apps y módulos de Yggdra</title>
    </svg>
  </div>
  <p class="visually-hidden" id="map-live" aria-live="polite"></p>
</div>

<script>
  type Consumer = {
    id: string;
    name: string;
    product?: string;
    company?: string;
    status: string;
    statusLabel: string;
    modules: string[];
  };

  const root = document.querySelector(".map-root") as HTMLElement | null;
  if (root) {
    const data = JSON.parse(root.dataset.map || "{}") as {
      consumers: Consumer[];
      modules: string[];
      base: string;
    };
    const body = root.querySelector("[data-matrix-body]") as HTMLElement;
    const filterInput = root.querySelector("[data-filter]") as HTMLInputElement;
    const statusSelect = root.querySelector("[data-status]") as HTMLSelectElement;
    const live = root.querySelector("#map-live") as HTMLElement;
    const graphSvg = root.querySelector("[data-graph]") as SVGSVGElement;
    const panels = {
      matrix: root.querySelector('[data-panel="matrix"]') as HTMLElement,
      graph: root.querySelector('[data-panel="graph"]') as HTMLElement,
    };
    const base = data.base || "/";

    function label(c: Consumer) {
      return c.product || c.name;
    }

    function filtered() {
      const q = (filterInput.value || "").trim().toLowerCase();
      const st = statusSelect.value;
      return data.consumers.filter((c) => {
        if (st && c.statusLabel !== st) return false;
        if (!q) return true;
        const hay = `${label(c)} ${c.company || ""} ${c.id}`.toLowerCase();
        return hay.includes(q);
      });
    }

    function renderMatrix() {
      const rows = filtered();
      body.innerHTML = rows
        .map((c) => {
          const cells = data.modules
            .map((m) => {
              const on = c.modules.includes(m) ? "1" : "0";
              const title = on === "1" ? `${label(c)} usa ${m}` : `${label(c)} no usa ${m}`;
              return `<td data-on="${on}" title="${title}"><span>${on === "1" ? "sí" : "no"}</span></td>`;
            })
            .join("");
          const company = c.company ? ` · ${c.company}` : "";
          const href = `${base}apps/${c.id}/`;
          return `<tr data-id="${c.id}"><th scope="row"><a href="${href}">${label(c)}</a>${company}</th>${cells}</tr>`;
        })
        .join("");
      live.textContent = `${rows.length} apps en la matriz.`;
    }

    function renderGraph() {
      const rows = filtered();
      const W = 920;
      const H = Math.max(420, 48 + rows.length * 28);
      graphSvg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      const modSet = new Set<string>();
      rows.forEach((c) => c.modules.forEach((m) => modSet.add(m)));
      const mods = data.modules.filter((m) => modSet.has(m));
      const appX = 140;
      const modX = 720;
      const appYs = rows.map((_, i) => 36 + (i * (H - 60)) / Math.max(rows.length - 1, 1));
      const modYs = mods.map((_, i) => 36 + (i * (H - 60)) / Math.max(mods.length - 1, 1));
      const modIndex = Object.fromEntries(mods.map((m, i) => [m, i]));

      let edges = "";
      rows.forEach((c, i) => {
        c.modules.forEach((m) => {
          if (!(m in modIndex)) return;
          const y1 = appYs[i];
          const y2 = modYs[modIndex[m]];
          edges += `<line class="edge" x1="${appX + 70}" y1="${y1}" x2="${modX - 70}" y2="${y2}" />`;
        });
      });

      const appNodes = rows
        .map((c, i) => {
          const y = appYs[i];
          const t = label(c).slice(0, 22);
          return `<a href="${base}apps/${c.id}/"><g data-app="${c.id}"><rect class="node-app" x="${appX - 70}" y="${y - 12}" width="140" height="24" rx="8"/><text x="${appX}" y="${y + 4}" text-anchor="middle">${t}</text></g></a>`;
        })
        .join("");

      const modNodes = mods
        .map((m, i) => {
          const y = modYs[i];
          return `<a href="${base}modulos/${encodeURIComponent(m)}/"><g data-mod="${m}"><rect class="node-mod" x="${modX - 70}" y="${y - 12}" width="140" height="24" rx="8"/><text x="${modX}" y="${y + 4}" text-anchor="middle">${m}</text></g></a>`;
        })
        .join("");

      graphSvg.innerHTML = `<title id="graph-title">Relación entre apps y módulos de Yggdra</title>${edges}${appNodes}${modNodes}`;
      live.textContent = `Grafo con ${rows.length} apps y ${mods.length} módulos.`;
    }

    function render() {
      renderMatrix();
      renderGraph();
    }

    root.querySelectorAll("[data-view]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const view = (btn as HTMLElement).dataset.view as "matrix" | "graph";
        root.querySelectorAll("[data-view]").forEach((b) => {
          b.setAttribute("aria-pressed", String(b === btn));
        });
        panels.matrix.classList.toggle("hidden", view !== "matrix");
        panels.graph.classList.toggle("hidden", view !== "graph");
      });
    });

    filterInput.addEventListener("input", render);
    statusSelect.addEventListener("change", render);
    render();
  }
</script>
