---
interface Props {
  name?: string;
  class?: string;
}
const { name = "algiz", class: className = "rune" } = Astro.props;
// Glifos geométricos estilo runa (acentos de sección, no alfabeto histórico literal).
const paths: Record<string, string> = {
  algiz: "M12 20 V6 M12 6 L5 12 M12 6 L19 12",
  ansuz: "M7 4 V20 M7 4 L17 9 L7 14",
  raidho: "M7 4 V20 M7 4 H14 C18 4 18 11 14 11 H7 M12 11 L18 20",
  eihwaz: "M12 3 V21 M12 3 L7 8 M12 21 L17 16",
  sowilo: "M7 5 H15 L9 12 H17 L9 19",
};
const d = paths[name] || paths.algiz;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={d} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
