---
/**
 * Diagrama en capas: Raíces → Tronco → Ramas (árbol / grafo).
 */
---

<div class="diagram-wrap glass panel">
  <svg class="diagram" viewBox="0 0 720 360" role="img" aria-labelledby="arch-title arch-desc">
    <title id="arch-title">Arquitectura en capas de Yggdra Platform</title>
    <desc id="arch-desc">
      Raíces como infraestructura, tronco como API y módulos, ramas como aplicaciones consumidoras.
    </desc>
    <!-- Fondo suave -->
    <defs>
      <linearGradient id="trunkGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2f6f66" stop-opacity="0.9"/>
        <stop offset="100%" stop-color="#1a3f4a" stop-opacity="0.9"/>
      </linearGradient>
    </defs>
    <!-- Ramas / apps -->
    <g class="edge">
      <path d="M360 120 L140 48"/>
      <path d="M360 120 L260 36"/>
      <path d="M360 120 L460 36"/>
      <path d="M360 120 L580 48"/>
      <path d="M360 150 L120 110"/>
      <path d="M360 150 L600 110"/>
    </g>
    <g>
      <rect class="node" x="70" y="28" width="120" height="36" rx="10"/>
      <text x="130" y="51" text-anchor="middle" font-size="12">App A</text>
      <rect class="node" x="205" y="16" width="110" height="36" rx="10"/>
      <text x="260" y="39" text-anchor="middle" font-size="12">App B</text>
      <rect class="node" x="405" y="16" width="110" height="36" rx="10"/>
      <text x="460" y="39" text-anchor="middle" font-size="12">App C</text>
      <rect class="node" x="530" y="28" width="120" height="36" rx="10"/>
      <text x="590" y="51" text-anchor="middle" font-size="12">App D</text>
      <rect class="node" x="50" y="92" width="120" height="36" rx="10"/>
      <text x="110" y="115" text-anchor="middle" font-size="12">App E</text>
      <rect class="node" x="550" y="92" width="120" height="36" rx="10"/>
      <text x="610" y="115" text-anchor="middle" font-size="12">App F</text>
    </g>
    <text class="muted" x="360" y="22" text-anchor="middle" font-size="11" letter-spacing="1.5">RAMAS · aplicaciones</text>

    <!-- Tronco -->
    <rect class="node-strong" x="250" y="120" width="220" height="100" rx="14"/>
    <text x="360" y="152" text-anchor="middle" font-size="13" font-weight="600">Tronco</text>
    <text class="muted" x="360" y="172" text-anchor="middle" font-size="11">API · módulos · OpenAPI</text>
    <text class="muted" x="360" y="192" text-anchor="middle" font-size="11">cuentas · sucursales · dominio</text>
    <rect x="348" y="220" width="24" height="36" rx="4" fill="url(#trunkGrad)"/>

    <!-- Raíces -->
    <g class="edge">
      <path d="M360 256 L200 310"/>
      <path d="M360 256 L360 320"/>
      <path d="M360 256 L520 310"/>
    </g>
    <rect class="node" x="120" y="300" width="150" height="36" rx="10"/>
    <text x="195" y="323" text-anchor="middle" font-size="12">Infraestructura</text>
    <rect class="node" x="285" y="312" width="150" height="36" rx="10"/>
    <text x="360" y="335" text-anchor="middle" font-size="12">CI / CD · observabilidad</text>
    <rect class="node" x="450" y="300" width="150" height="36" rx="10"/>
    <text x="525" y="323" text-anchor="middle" font-size="12">Datos · aislamiento</text>
    <text class="muted" x="360" y="292" text-anchor="middle" font-size="11" letter-spacing="1.5">RAÍCES</text>
  </svg>
</div>
