---
interface Props {
  size?: number;
  class?: string;
  animated?: boolean;
}
const { size = 36, class: className = "", animated = false } = Astro.props;
const uid = `ym-${Math.random().toString(36).slice(2, 7)}`;
---

<svg
  class={`yarq-mark ${animated ? "yarq-mark--anim" : ""} ${className}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${uid}-bg`} x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#070c18"></stop>
      <stop offset="100%" stop-color="#131c36"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-stroke`} x1="12" y1="11" x2="36" y2="37" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#f8fafc"></stop>
      <stop offset="52%" stop-color="#38bdf8"></stop>
      <stop offset="100%" stop-color="#8b5cf6"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-rim`} x1="0" y1="0" x2="48" y2="48" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.65"></stop>
      <stop offset="50%" stop-color="#8b5cf6" stop-opacity="0.35"></stop>
      <stop offset="100%" stop-color="#ffffff" stop-opacity="0.18"></stop>
    </linearGradient>
  </defs>

  <!-- Cápsula minimal obsidiana -->
  <rect x="2" y="2" width="44" height="44" rx="13" fill={`url(#${uid}-bg)`} stroke={`url(#${uid}-rim)`} stroke-width="1.2"></rect>

  <!-- Faceta Y minimalista y geométrica -->
  <path
    class="yarq-mark__arm"
    d="M14.5 14L24 24.5L33.5 14"
    stroke={`url(#${uid}-stroke)`}
    stroke-width="3.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    class="yarq-mark__stem"
    d="M24 24.5V35"
    stroke="#f8fafc"
    stroke-width="3.2"
    stroke-linecap="round"
  ></path>

  <!-- Singularidad flotante superior -->
  <circle class="yarq-mark__dot" cx="24" cy="13.5" r="2.2" fill="#38bdf8"></circle>
</svg>

<style>
  .yarq-mark {
    display: block;
    flex-shrink: 0;
  }

  .yarq-mark--anim .yarq-mark__dot {
    animation: ym-pulse 3.2s ease-in-out infinite;
    transform-origin: 24px 13.5px;
  }

  @keyframes ym-pulse {
    0%, 100% {
      opacity: 0.72;
      transform: scale(0.92);
    }
    50% {
      opacity: 1;
      transform: scale(1.18);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yarq-mark--anim .yarq-mark__dot {
      animation: none;
    }
  }
</style>
