---
interface Props {
  size?: number;
  class?: string;
  animated?: boolean;
}
const { size = 36, class: className = "", animated = true } = Astro.props;
const uid = "logo-y-mark";
---

<svg
  class={`logo-y ${animated ? "logo-y--animated" : ""} ${className}`.trim()}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 96 96"
  width={size}
  height={size}
  role="img"
  aria-label="YARQ"
>
  <defs>
    <linearGradient id={`${uid}-stroke`} x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#148a98"></stop>
      <stop offset="55%" stop-color="#0d6e7a"></stop>
      <stop offset="100%" stop-color="#0f1c22"></stop>
    </linearGradient>
  </defs>
  <g class="logo-guides" stroke="#7aa3ab" stroke-width="0.7" opacity="0.45">
    <line x1="8" y1="88" x2="48" y2="12"></line>
    <line x1="88" y1="88" x2="48" y2="12"></line>
    <line x1="18" y1="88" x2="48" y2="28"></line>
    <line x1="78" y1="88" x2="48" y2="28"></line>
  </g>
  <path
    class="logo-mark"
    d="M22 18 L48 52 L74 18 M48 52 V82"
    fill="none"
    stroke={`url(#${uid}-stroke)`}
    stroke-width="5.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle class="logo-node" cx="22" cy="18" r="3.2" fill="#148a98"></circle>
  <circle class="logo-node" cx="74" cy="18" r="3.2" fill="#148a98"></circle>
  <circle class="logo-node logo-node--core" cx="48" cy="52" r="4" fill="#0f1c22"></circle>
  <circle class="logo-node" cx="48" cy="82" r="3" fill="#5a8a94"></circle>
</svg>

<style>
  .logo-y {
    display: block;
    flex-shrink: 0;
  }

  .logo-y--animated .logo-mark {
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    animation: logo-y-draw 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
  }

  .logo-y--animated .logo-node {
    opacity: 0;
    transform-origin: center;
    animation: logo-y-node 0.5s ease 1.15s forwards;
  }

  .logo-y--animated .logo-guides {
    opacity: 0;
    animation: logo-y-guides 0.8s ease 0.05s forwards;
  }

  @keyframes logo-y-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes logo-y-node {
    from {
      opacity: 0;
      transform: scale(0.45);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes logo-y-guides {
    to {
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-y--animated .logo-mark,
    .logo-y--animated .logo-node,
    .logo-y--animated .logo-guides {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 1;
      transform: none;
    }
    .logo-y--animated .logo-guides {
      opacity: 0.45;
    }
  }
</style>
