---
/**
 * Diagrama isométrico espacial de YARQ (sólido, alto contraste, sin traslucidez):
 * Singularidad YARQ + túneles orbitales + 4 módulos isométricos en obsidiana.
 */
---

<div
  class="space-iso"
  role="img"
  aria-label="Diagrama espacial isométrico de YARQ: núcleo orbital conectado a plataformas, integraciones, lanzamiento y automatización"
>
  <svg class="space-iso__svg" viewBox="0 0 1040 380" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="si-nebula" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#312e81" stop-opacity="0.28"></stop>
        <stop offset="38%" stop-color="#0284c7" stop-opacity="0.16"></stop>
        <stop offset="70%" stop-color="#06b6d4" stop-opacity="0.06"></stop>
        <stop offset="100%" stop-color="#06b6d4" stop-opacity="0"></stop>
      </radialGradient>

      <radialGradient id="si-horizon" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#02050c"></stop>
        <stop offset="52%" stop-color="#081024"></stop>
        <stop offset="76%" stop-color="#1e1b4b"></stop>
        <stop offset="92%" stop-color="#06b6d4" stop-opacity="0.95"></stop>
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"></stop>
      </radialGradient>

      <linearGradient id="si-ring-a" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#22d3ee"></stop>
        <stop offset="50%" stop-color="#3b82f6"></stop>
        <stop offset="100%" stop-color="#8b5cf6"></stop>
      </linearGradient>

      <linearGradient id="si-ring-b" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8"></stop>
        <stop offset="52%" stop-color="#6366f1"></stop>
        <stop offset="100%" stop-color="#c084fc"></stop>
      </linearGradient>

      <!-- Caras sólidas obsidiana para las 4 placas isométricas (cero traslucidez) -->
      <linearGradient id="si-top-dark" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#0f172a"></stop>
        <stop offset="100%" stop-color="#070c18"></stop>
      </linearGradient>
      <linearGradient id="si-side-l" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#16233d"></stop>
        <stop offset="100%" stop-color="#0b1324"></stop>
      </linearGradient>
      <linearGradient id="si-side-r" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#0c1528"></stop>
        <stop offset="100%" stop-color="#050914"></stop>
      </linearGradient>

      <linearGradient id="si-conduit-a" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#06b6d4"></stop>
        <stop offset="50%" stop-color="#6366f1"></stop>
        <stop offset="100%" stop-color="#38bdf8"></stop>
      </linearGradient>

      <filter id="si-glow" x="-35%" y="-35%" width="170%" height="170%">
        <feGaussianBlur stdDeviation="4.5" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>

      <filter id="si-shadow" x="-25%" y="-25%" width="150%" height="175%">
        <feDropShadow dx="0" dy="14" stdDeviation="10" flood-color="#070c18" flood-opacity="0.28"></feDropShadow>
      </filter>
    </defs>

    <!-- Halo gravitacional -->
    <ellipse cx="520" cy="190" rx="380" ry="155" fill="url(#si-nebula)"></ellipse>

    <!-- Anillos de túnel espacial (izquierda y derecha) -->
    <g fill="none" stroke="url(#si-ring-a)">
      <ellipse class="si-tunnel-ring" cx="220" cy="190" rx="22" ry="52" stroke-opacity="0.22" stroke-width="1.2"></ellipse>
      <ellipse class="si-tunnel-ring" cx="285" cy="190" rx="28" ry="68" stroke-opacity="0.32" stroke-width="1.3"></ellipse>
      <ellipse class="si-tunnel-ring" cx="355" cy="190" rx="36" ry="84" stroke-opacity="0.44" stroke-width="1.45"></ellipse>
    </g>
    <g fill="none" stroke="url(#si-ring-b)">
      <ellipse class="si-tunnel-ring" cx="685" cy="190" rx="36" ry="84" stroke-opacity="0.44" stroke-width="1.45"></ellipse>
      <ellipse class="si-tunnel-ring" cx="755" cy="190" rx="28" ry="68" stroke-opacity="0.32" stroke-width="1.3"></ellipse>
      <ellipse class="si-tunnel-ring" cx="820" cy="190" rx="22" ry="52" stroke-opacity="0.22" stroke-width="1.2"></ellipse>
    </g>

    <!-- Conductos de datos sólidos + trazos de energía -->
    <path
      id="si-path-1"
      d="M 145 106 C 275 106, 375 162, 520 190 C 665 218, 765 274, 895 274"
      fill="none"
      stroke="#0f172a"
      stroke-opacity="0.22"
      stroke-width="2.5"
    ></path>
    <path
      class="si-beam"
      d="M 145 106 C 275 106, 375 162, 520 190 C 665 218, 765 274, 895 274"
      fill="none"
      stroke="url(#si-conduit-a)"
      stroke-width="1.8"
      stroke-dasharray="10 8"
    ></path>

    <path
      id="si-path-2"
      d="M 145 274 C 275 274, 375 218, 520 190 C 665 162, 765 106, 895 106"
      fill="none"
      stroke="#0f172a"
      stroke-opacity="0.22"
      stroke-width="2.5"
    ></path>
    <path
      class="si-beam si-beam--rev"
      d="M 145 274 C 275 274, 375 218, 520 190 C 665 162, 765 106, 895 106"
      fill="none"
      stroke="url(#si-ring-b)"
      stroke-width="1.8"
      stroke-dasharray="9 9"
    ></path>

    <!-- Pulsos luminosos viajando por los conductos -->
    <circle class="si-packet" r="4.8" fill="#22d3ee" filter="url(#si-glow)">
      <animateMotion dur="4.6s" repeatCount="indefinite">
        <mpath href="#si-path-1"></mpath>
      </animateMotion>
    </circle>
    <circle class="si-packet" r="4.2" fill="#a855f7" filter="url(#si-glow)">
      <animateMotion dur="5.8s" begin="-2.2s" repeatCount="indefinite">
        <mpath href="#si-path-2"></mpath>
      </animateMotion>
    </circle>
    <circle class="si-packet" r="3.4" fill="#38bdf8" filter="url(#si-glow)">
      <animateMotion dur="7.2s" begin="-3.8s" repeatCount="indefinite">
        <mpath href="#si-path-1"></mpath>
      </animateMotion>
    </circle>
    <circle class="si-packet" r="3.4" fill="#c084fc" filter="url(#si-glow)">
      <animateMotion dur="6.6s" begin="-1.1s" repeatCount="indefinite">
        <mpath href="#si-path-2"></mpath>
      </animateMotion>
    </circle>

    <!-- Núcleo gravitacional YARQ -->
    <g transform="translate(520 190)">
      <circle
        class="si-alch-ring"
        cx="0"
        cy="0"
        r="118"
        fill="none"
        stroke="#0f172a"
        stroke-opacity="0.24"
        stroke-width="1.1"
        stroke-dasharray="2 7"
      ></circle>

      <!-- Órbitas inclinadas -->
      <ellipse
        class="si-accretion si-accretion--outer"
        cx="0"
        cy="0"
        rx="156"
        ry="54"
        fill="none"
        stroke="url(#si-ring-a)"
        stroke-width="2.1"
        stroke-dasharray="16 8"
      ></ellipse>
      <ellipse
        class="si-accretion si-accretion--inner"
        cx="0"
        cy="0"
        rx="106"
        ry="36"
        fill="none"
        stroke="url(#si-ring-b)"
        stroke-width="2.2"
        stroke-dasharray="10 6"
      ></ellipse>

      <!-- Horizonte de eventos sólido -->
      <circle cx="0" cy="0" r="52" fill="url(#si-horizon)" filter="url(#si-glow)"></circle>
      <circle cx="0" cy="0" r="35" fill="#040711" stroke="#38bdf8" stroke-opacity="0.45" stroke-width="1"></circle>
      <circle
        class="si-photon-ring"
        cx="0"
        cy="0"
        r="40"
        fill="none"
        stroke="#38bdf8"
        stroke-width="1.6"
      ></circle>

      <text
        x="0"
        y="4.5"
        text-anchor="middle"
        fill="#f8fafc"
        font-family="Syne, sans-serif"
        font-size="13.5"
        font-weight="700"
        letter-spacing="3.2"
      >YARQ</text>
    </g>

    <!-- 01 · PLATAFORMAS (placa isométrica sólida obsidiana) -->
    <g class="si-tile si-tile--a" transform="translate(132 104)" filter="url(#si-shadow)">
      <polygon points="0,-34 86,-2 0,30 -86,-2" fill="url(#si-top-dark)" stroke="#22d3ee" stroke-width="1.5"></polygon>
      <polygon points="-86,-2 0,30 0,43 -86,11" fill="url(#si-side-l)" stroke="#1e3a5f" stroke-width="0.8"></polygon>
      <polygon points="86,-2 0,30 0,43 86,11" fill="url(#si-side-r)" stroke="#0f172a" stroke-width="0.8"></polygon>
      <!-- Líneas interiores técnicas -->
      <polygon points="0,-18 44,-2 0,14 -44,-2" fill="none" stroke="#22d3ee" stroke-opacity="0.45" stroke-width="1"></polygon>
      <circle cx="0" cy="-2" r="4.5" fill="#22d3ee"></circle>
      <!-- Etiqueta de alto contraste -->
      <g transform="translate(0 -56)">
        <rect x="-64" y="-12" width="128" height="22" rx="11" fill="#070c18" stroke="#22d3ee" stroke-opacity="0.55" stroke-width="1"></rect>
        <text x="0" y="2.5" text-anchor="middle" class="si-pill-text">01 · PLATAFORMAS</text>
      </g>
    </g>

    <!-- 02 · INTEGRACIONES -->
    <g class="si-tile si-tile--b" transform="translate(132 272)" filter="url(#si-shadow)">
      <polygon points="0,-34 86,-2 0,30 -86,-2" fill="url(#si-top-dark)" stroke="#818cf8" stroke-width="1.5"></polygon>
      <polygon points="-86,-2 0,30 0,43 -86,11" fill="url(#si-side-l)" stroke="#312e81" stroke-width="0.8"></polygon>
      <polygon points="86,-2 0,30 0,43 86,11" fill="url(#si-side-r)" stroke="#0f172a" stroke-width="0.8"></polygon>
      <polygon points="0,-18 44,-2 0,14 -44,-2" fill="none" stroke="#818cf8" stroke-opacity="0.45" stroke-width="1"></polygon>
      <circle cx="0" cy="-2" r="4.5" fill="#818cf8"></circle>
      <g transform="translate(0 64)">
        <rect x="-68" y="-12" width="136" height="22" rx="11" fill="#070c18" stroke="#818cf8" stroke-opacity="0.55" stroke-width="1"></rect>
        <text x="0" y="2.5" text-anchor="middle" class="si-pill-text">02 · INTEGRACIONES</text>
      </g>
    </g>

    <!-- 03 · LANZAMIENTO -->
    <g class="si-tile si-tile--c" transform="translate(908 104)" filter="url(#si-shadow)">
      <polygon points="0,-34 86,-2 0,30 -86,-2" fill="url(#si-top-dark)" stroke="#a855f7" stroke-width="1.5"></polygon>
      <polygon points="-86,-2 0,30 0,43 -86,11" fill="url(#si-side-l)" stroke="#4c1d95" stroke-width="0.8"></polygon>
      <polygon points="86,-2 0,30 0,43 86,11" fill="url(#si-side-r)" stroke="#0f172a" stroke-width="0.8"></polygon>
      <polygon points="0,-18 44,-2 0,14 -44,-2" fill="none" stroke="#a855f7" stroke-opacity="0.45" stroke-width="1"></polygon>
      <circle cx="0" cy="-2" r="4.5" fill="#a855f7"></circle>
      <g transform="translate(0 -56)">
        <rect x="-64" y="-12" width="128" height="22" rx="11" fill="#070c18" stroke="#a855f7" stroke-opacity="0.55" stroke-width="1"></rect>
        <text x="0" y="2.5" text-anchor="middle" class="si-pill-text">03 · LANZAMIENTO</text>
      </g>
    </g>

    <!-- 04 · AUTOMATIZACIÓN -->
    <g class="si-tile si-tile--d" transform="translate(908 272)" filter="url(#si-shadow)">
      <polygon points="0,-34 86,-2 0,30 -86,-2" fill="url(#si-top-dark)" stroke="#38bdf8" stroke-width="1.5"></polygon>
      <polygon points="-86,-2 0,30 0,43 -86,11" fill="url(#si-side-l)" stroke="#0c4a6e" stroke-width="0.8"></polygon>
      <polygon points="86,-2 0,30 0,43 86,11" fill="url(#si-side-r)" stroke="#0f172a" stroke-width="0.8"></polygon>
      <polygon points="0,-18 44,-2 0,14 -44,-2" fill="none" stroke="#38bdf8" stroke-opacity="0.45" stroke-width="1"></polygon>
      <circle cx="0" cy="-2" r="4.5" fill="#38bdf8"></circle>
      <g transform="translate(0 64)">
        <rect x="-72" y="-12" width="144" height="22" rx="11" fill="#070c18" stroke="#38bdf8" stroke-opacity="0.55" stroke-width="1"></rect>
        <text x="0" y="2.5" text-anchor="middle" class="si-pill-text">04 · AUTOMATIZACIÓN</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .space-iso {
    width: 100%;
    max-width: 1020px;
    margin-inline: auto;
    position: relative;
  }

  .space-iso__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .si-pill-text {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    fill: #e2e8f0;
  }

  .si-beam {
    animation: si-flow 14s linear infinite;
  }

  .si-beam--rev {
    animation-direction: reverse;
    animation-duration: 18s;
  }

  .si-alch-ring {
    animation: si-spin 36s linear infinite;
  }

  .si-accretion--outer {
    animation: si-dash 18s linear infinite;
  }

  .si-accretion--inner {
    animation: si-dash 11s linear infinite reverse;
  }

  .si-photon-ring {
    animation: si-breathe 3.2s ease-in-out infinite;
  }

  .si-tile--a { animation: si-hover-a 5.5s ease-in-out infinite alternate; }
  .si-tile--b { animation: si-hover-b 6.2s ease-in-out infinite alternate; }
  .si-tile--c { animation: si-hover-c 5.8s ease-in-out infinite alternate; }
  .si-tile--d { animation: si-hover-d 6.4s ease-in-out infinite alternate; }

  @keyframes si-flow {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -240; }
  }

  @keyframes si-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes si-dash {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -180; }
  }

  @keyframes si-breathe {
    0%, 100% { stroke-opacity: 0.45; }
    50% { stroke-opacity: 1; }
  }

  @keyframes si-hover-a {
    from { transform: translate(132px, 104px); }
    to { transform: translate(132px, 95px); }
  }
  @keyframes si-hover-b {
    from { transform: translate(132px, 272px); }
    to { transform: translate(132px, 280px); }
  }
  @keyframes si-hover-c {
    from { transform: translate(908px, 104px); }
    to { transform: translate(908px, 95px); }
  }
  @keyframes si-hover-d {
    from { transform: translate(908px, 272px); }
    to { transform: translate(908px, 263px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .si-beam,
    .si-alch-ring,
    .si-accretion,
    .si-photon-ring,
    .si-tile {
      animation: none;
    }
    .si-packet {
      display: none;
    }
  }
</style>
