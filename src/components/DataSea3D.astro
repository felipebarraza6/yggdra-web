      // ─── IOT + INFERENCIA + PARTÍCULAS: misma capa lógica en el mundo real a color y en el plano de datos ───
      type IotNode = {
        nx: number;
        lift: number; // px sobre la costa (se escala con h)
        label: string;
        unit: string;
        base: number;
        amp: number;
        dec: number;
        col: string;
      };

      const IOT_NODES: IotNode[] = [
        { nx: 0.018, lift: 26, label: "CO₂", unit: " ppm", base: 412, amp: 9, dec: 0, col: "52, 211, 153" },
        { nx: 0.16, lift: 138, label: "VIENTO", unit: " m/s", base: 6.2, amp: 1.4, dec: 1, col: "125, 211, 252" },
        { nx: 0.232, lift: 70, label: "pH", unit: "", base: 7.2, amp: 0.12, dec: 2, col: "186, 230, 253" },
        { nx: 0.33, lift: 40, label: "RIEGO", unit: " %", base: 38, amp: 6, dec: 0, col: "134, 239, 172" },
