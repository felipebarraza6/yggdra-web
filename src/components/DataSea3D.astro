---
/**
 * Mundo Dual 3D de YARQ:
 * - Capa base: nubes sutiles en el cielo, cordillera topográfica, centros de datos y antenas en el horizonte, y mar de datos 3D.
 * - Capa revelada al pasar el cursor: portal pixelado con aurora boreal que revela el mismo paisaje con colores vivos y reales.
 */
---

<canvas class="datasea-canvas" data-datasea aria-hidden="true"></canvas>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canvases = document.querySelectorAll<HTMLCanvasElement>("[data-datasea]");

  if (canvases.length > 0) {
    canvases.forEach((canvas) => {
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let w = 0;
      let h = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let raf = 0;
      let t = 0;
      // Regulador de calidad: si el cuadro se alarga, se dibuja la mitad de la bandada hasta recuperar fluidez
      let frameEma = 16;
      let lastFrameMs = 0;
      let lowQuality = false;
      let intro = reduce ? 1 : 0;
      let dive = 0;
      let diveTarget = 0;

      const updateDive = () => {
        const span = Math.max(420, h * 0.88);
        diveTarget = Math.max(0, Math.min(1, window.scrollY / span));
      };
      window.addEventListener("scroll", updateDive, { passive: true });

      // Canvas offscreen para fundir la realidad revelada con borde líquido suave (sin píxeles cuadrados)
      const portalCanvas = document.createElement("canvas");
      const pctx = portalCanvas.getContext("2d");

      const mouse = {
        x: 0,
        tx: 0,
        px: -9999,
        py: -9999,
        sx: -9999,
        sy: -9999,
        active: false,
        reveal: 0,
      };

      const COLS = 72;
      const ROWS = 36;
      const SEP_X = 76;

      // Nubes suaves en el cielo que se desplazan con calma
      const clouds = [
        { x: 0.14, y: 0.17, rx: 110, ry: 22, speed: 0.00008 },
        { x: 0.38, y: 0.11, rx: 145, ry: 26, speed: 0.000055 },
        { x: 0.72, y: 0.15, rx: 130, ry: 24, speed: 0.00007 },
        { x: 0.89, y: 0.24, rx: 95, ry: 19, speed: 0.00009 },
        { x: 0.24, y: 0.28, rx: 92, ry: 18, speed: 0.000065 },
      ];

      function mountainHeight(nx: number, seed: number, amp: number) {
        const valley = 0.28 + 0.72 * Math.pow(Math.abs(nx * 2 - 1), 1.18);
        const ridge =
          Math.sin(nx * 8.2 + seed) * 0.44 +
          Math.sin(nx * 19.6 + seed * 1.8) * 0.28 +
          Math.cos(nx * 37.4 + seed * 0.6) * 0.17 +
          Math.sin(nx * 71.2 + seed * 2.3) * 0.09;
        return Math.max(0, 0.56 + ridge * 0.56) * valley * amp;
      }

      function cellHash(gx: number, gy: number) {
        const n = Math.sin(gx * 127.1 + gy * 311.7) * 43758.5453;
        return n - Math.floor(n);
      }

      let textSafe = {
        cx: 0,
        cy: 0,
        rx: 320,
        ry: 150,
      };
      const copyStackEl = canvas.parentElement?.querySelector(".hero-copy-stack") as HTMLElement | null;
      const darkLensEl = canvas.parentElement?.querySelector(
        "[data-hero-dark-lens]"
      ) as HTMLElement | null;
      let darkLensVisible = false;

      function syncDarkLensText(lx: number, ly: number, hw: number, hh: number) {
        if (!darkLensEl || !copyStackEl) return;
        if (hw < 4 || hh < 4) {
          if (darkLensVisible) {
            darkLensEl.style.setProperty("--lens-t", "100%");
            darkLensVisible = false;
          }
          return;
        }
        const cRect = canvas.getBoundingClientRect();
        const sRect = copyStackEl.getBoundingClientRect();
        const sL = sRect.left - cRect.left;
        const sT = sRect.top - cRect.top;
        const sW = sRect.width;
        const sH = sRect.height;
        if (sW <= 0 || sH <= 0) return;

        const tPx = Math.max(0, Math.min(sH, ly - hh - sT));
        const lPx = Math.max(0, Math.min(sW, lx - hw - sL));
        const bPx = Math.max(0, Math.min(sH, sT + sH - (ly + hh)));
        const rPx = Math.max(0, Math.min(sW, sL + sW - (lx + hw)));
        if (tPx + bPx >= sH || lPx + rPx >= sW) {
          if (darkLensVisible) {
            darkLensEl.style.setProperty("--lens-t", "100%");
            darkLensVisible = false;
          }
          return;
        }
        darkLensEl.style.setProperty("--lens-t", `${tPx.toFixed(1)}px`);
        darkLensEl.style.setProperty("--lens-r", `${rPx.toFixed(1)}px`);
        darkLensEl.style.setProperty("--lens-b", `${bPx.toFixed(1)}px`);
        darkLensEl.style.setProperty("--lens-l", `${lPx.toFixed(1)}px`);
        darkLensVisible = true;
      }

      // Origen exacto del logo de partículas YARQ desde donde despegan los drones estorninos
      let yarqOrigin = { x: 0, y: 120 };
      // Medio ancho y medio alto del logo YARQ sólido: zona que los estorninos no deben ensuciar
      let yarqHalf = { x: 150, y: 60 };
      let fullReality = false;
      let fullReveal = 0;

      window.addEventListener("yarq:reality", (e: Event) => {
        const ce = e as CustomEvent<{ full?: boolean }>;
        fullReality = Boolean(ce.detail?.full);
      });

      const fxSmooth = (a: number, b: number, v: number) => {
        const x = Math.min(1, Math.max(0, (v - a) / (b - a)));
        return x * x * (3 - 2 * x);
      };

      const lerpRGBA = (
        r1: number,
        g1: number,
        b1: number,
        a1: number,
        r2: number,
        g2: number,
        b2: number,
        a2: number,
        k: number
      ) =>
        `rgba(${Math.round(r2 + (r1 - r2) * k)}, ${Math.round(g2 + (g1 - g2) * k)}, ${Math.round(
          b2 + (b1 - b2) * k
        )}, ${(a2 + (a1 - a2) * k).toFixed(3)})`;

      // Tráfico aéreo y orbital compartido 1:1 entre el mundo real y los planos matemáticos del cuadrante de datos
      type SkyCraft = {
        yFrac: number;
        speed: number;
        dir: 1 | -1;
        scale: number;
        kind: "ship" | "sat";
        col: string;
        code: string;
      };

      const SKY_CRAFTS: SkyCraft[] = [
        { yFrac: 0.16, speed: 0.032, dir: 1, scale: 1.05, kind: "ship", col: "#38bdf8", code: "FL-380" },
        { yFrac: 0.28, speed: 0.024, dir: -1, scale: 0.85, kind: "sat", col: "#34d399", code: "SAT-02" },
        { yFrac: 0.38, speed: 0.044, dir: 1, scale: 0.72, kind: "ship", col: "#c084fc", code: "FL-420" },
        { yFrac: 0.22, speed: 0.019, dir: -1, scale: 0.78, kind: "sat", col: "#7dd3fc", code: "ORB-04" },
        { yFrac: 0.12, speed: 0.027, dir: -1, scale: 0.7, kind: "ship", col: "#38bdf8", code: "FL-300" },
        { yFrac: 0.33, speed: 0.021, dir: 1, scale: 0.8, kind: "sat", col: "#34d399", code: "SAT-07" },
      ];

      // Escuadrón de 4 micro-drones de precisión que salen desde YARQ y levitan en las 4 esquinas para rasgar y abrir el cuadrante
      type QuadDrone = {
        x: number;
        y: number;
        vx: number;
        vy: number;
        sx: -1 | 1;
        sy: -1 | 1;
        slot: number;
        phase: number;
        initialized: boolean;
      };

      const quadDrones: QuadDrone[] = [
        { x: 0, y: 0, vx: 0, vy: 0, sx: -1, sy: -1, slot: 0, phase: 0.4, initialized: false },
        { x: 0, y: 0, vx: 0, vy: 0, sx: 1, sy: -1, slot: 1, phase: 1.9, initialized: false },
        { x: 0, y: 0, vx: 0, vy: 0, sx: 1, sy: 1, slot: 2, phase: 3.4, initialized: false },
        { x: 0, y: 0, vx: 0, vy: 0, sx: -1, sy: 1, slot: 3, phase: 4.9, initialized: false },
      ];

      function resize() {
        const rect = canvas.parentElement?.getBoundingClientRect();
        w = Math.max(320, Math.floor(rect?.width || window.innerWidth));
        h = Math.max(540, Math.floor(rect?.height || window.innerHeight));
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        canvas.style.width = `${w}px`;
        canvas.style.height = `${h}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Buffer del tamaño del cuadrante de hover, a la misma densidad que la pantalla: se ve nítido y no se pinta el resto
        const lensCssW = 205 * 2 + 40;
        const lensCssH = 145 * 2 + 40;
        portalCanvas.width = Math.ceil(lensCssW * dpr);
        portalCanvas.height = Math.ceil(lensCssH * dpr);
        if (pctx) pctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const markEl =
          canvas.parentElement?.querySelector(".yarq-3d__canvas") ||
          canvas.parentElement?.querySelector(".hero-mark-lockup");
        if (rect && markEl) {
          const mr = markEl.getBoundingClientRect();
          yarqOrigin = {
            x: mr.left - rect.left + mr.width * 0.5,
            y: mr.top - rect.top + mr.height * 0.5,
          };
          yarqHalf = { x: mr.width * 0.41, y: mr.height * 0.34 };
        } else {
          yarqOrigin = { x: w * 0.5, y: h * 0.16 };
          yarqHalf = { x: 130, y: 42 };
        }

        quadDrones.forEach((d) => {
          if (!d.initialized) {
            d.x = yarqOrigin.x + (d.slot - 1.5) * (yarqHalf.x * 0.45);
            d.y = yarqOrigin.y;
            d.initialized = true;
          }
        });

        const copyEl = canvas.parentElement?.querySelector(".hero-stage-copy");
        if (rect && copyEl) {
          const cr = copyEl.getBoundingClientRect();
          textSafe = {
            cx: cr.left - rect.left + cr.width * 0.5,
            cy: cr.top - rect.top + cr.height * 0.5,
            rx: cr.width * 0.54 + 48,
            ry: cr.height * 0.56 + 36,
          };
        } else {
          textSafe = {
            cx: w * 0.5,
            cy: h * 0.36,
            rx: Math.min(w * 0.36, 360),
            ry: Math.min(h * 0.22, 185),
          };
        }
      }

      const onMove = (e: MouseEvent) => {
        const rect = canvas.getBoundingClientRect();
        const lx = e.clientX - rect.left;
        const ly = e.clientY - rect.top;
        mouse.px = lx;
        mouse.py = ly;
        mouse.active = lx >= 0 && lx <= w && ly >= 0 && ly <= h;
        mouse.tx = (lx / w - 0.5) * 2;
        if (mouse.sx < -1000) {
          mouse.sx = lx;
          mouse.sy = ly;
        }
      };

      const onLeave = () => {
        mouse.active = false;
        mouse.tx = 0;
      };

      window.addEventListener("mousemove", onMove, { passive: true });
      canvas.parentElement?.addEventListener("mouseleave", onLeave, { passive: true });
      window.addEventListener("resize", resize, { passive: true });
      resize();

      type Projected = {
        sx: number;
        sy: number;
        syDeep: number;
        scale: number;
        elev: number;
        depthNorm: number;
        rip: number;
      };

      type HorizonNode = {
        x: number;
        y: number;
        scale: number;
        depth: number; // 0 = lejos, 1 = costa cercana
        layerIdx: 1 | 2; // 1 = cordillera media, 2 = costa frontal (oclusión real por profundidad)
        kind: "datacenter" | "campus" | "antenna";
      };

      // Red armónica de centros de datos, campus costeros y antenas anclados en su capa de relieve exacta
      function computeHorizonNodes(coastY: number): HorizonNode[] {
        const defs: {
          nx: number;
          seed: number;
          amp: number;
          yOff: number;
          scale: number;
          depth: number;
          layerIdx: 1 | 2;
          kind: HorizonNode["kind"];
        }[] = [
          // Capa 1 (cordillera media: quedan DETRÁS de la costa frontal)
          { nx: 0.08, seed: 4.8, amp: Math.min(118, h * 0.165), yOff: -2, scale: 0.62, depth: 0.35, layerIdx: 1, kind: "antenna" },
          { nx: 0.19, seed: 4.8, amp: Math.min(118, h * 0.165), yOff: -2, scale: 0.68, depth: 0.4, layerIdx: 1, kind: "datacenter" },
          { nx: 0.37, seed: 4.8, amp: Math.min(118, h * 0.165), yOff: -2, scale: 0.54, depth: 0.3, layerIdx: 1, kind: "datacenter" },
          { nx: 0.63, seed: 4.8, amp: Math.min(118, h * 0.165), yOff: -2, scale: 0.54, depth: 0.3, layerIdx: 1, kind: "datacenter" },
          { nx: 0.82, seed: 4.8, amp: Math.min(118, h * 0.165), yOff: -2, scale: 0.68, depth: 0.4, layerIdx: 1, kind: "datacenter" },
          { nx: 0.92, seed: 4.8, amp: Math.min(118, h * 0.165), yOff: -2, scale: 0.62, depth: 0.35, layerIdx: 1, kind: "antenna" },
          // Capa 2 (costa frontal: se apoyan en primer plano sobre la costa)
          { nx: 0.14, seed: 8.2, amp: Math.min(68, h * 0.095), yOff: 0, scale: 1.0, depth: 0.95, layerIdx: 2, kind: "campus" },
          { nx: 0.28, seed: 8.2, amp: Math.min(68, h * 0.095), yOff: 0, scale: 0.88, depth: 0.85, layerIdx: 2, kind: "antenna" },
          { nx: 0.72, seed: 8.2, amp: Math.min(68, h * 0.095), yOff: 0, scale: 0.88, depth: 0.85, layerIdx: 2, kind: "antenna" },
          { nx: 0.86, seed: 8.2, amp: Math.min(68, h * 0.095), yOff: 0, scale: 1.0, depth: 0.95, layerIdx: 2, kind: "campus" },
        ];
        return defs.map((d) => ({
          x: d.nx * w,
          y: coastY + d.yOff - mountainHeight(d.nx, d.seed, d.amp),
          scale: d.scale,
          depth: d.depth,
          layerIdx: d.layerIdx,
          kind: d.kind,
        }));
      }

      // Nubes suaves (versión abstracta minimal o versión realista iluminada por aurora)
      function drawClouds(targetCtx: CanvasRenderingContext2D, realistic: boolean) {
        clouds.forEach((c, idx) => {
          const cx = ((c.x + t * c.speed * 42) % 1.24 - 0.12) * w;
          const cy = c.y * h;
          const puffs = [
            { ox: 0, oy: 0, rx: c.rx, ry: c.ry },
            { ox: -c.rx * 0.45, oy: 4, rx: c.rx * 0.65, ry: c.ry * 0.76 },
            { ox: c.rx * 0.48, oy: 5, rx: c.rx * 0.6, ry: c.ry * 0.72 },
          ];

          puffs.forEach((p) => {
            const g = targetCtx.createRadialGradient(
              cx + p.ox,
              cy + p.oy,
              2,
              cx + p.ox,
              cy + p.oy,
              p.rx
            );
            if (realistic) {
              g.addColorStop(0, idx % 2 === 0 ? "rgba(186, 230, 253, 0.28)" : "rgba(167, 243, 208, 0.24)");
              g.addColorStop(0.55, "rgba(56, 189, 248, 0.12)");
              g.addColorStop(1, "rgba(15, 23, 42, 0)");
            } else {
              g.addColorStop(0, "rgba(255, 255, 255, 0.78)");
              g.addColorStop(0.55, "rgba(226, 238, 248, 0.34)");
              g.addColorStop(1, "rgba(226, 238, 248, 0)");
            }
            targetCtx.save();
            targetCtx.translate(cx + p.ox, cy + p.oy);
            targetCtx.scale(1, p.ry / p.rx);
            targetCtx.fillStyle = g;
            targetCtx.beginPath();
            targetCtx.arc(0, 0, p.rx, 0, Math.PI * 2);
            targetCtx.fill();
            targetCtx.restore();
          });
        });
      }

      // Campo de partículas, matemáticas y telemetría numérica para el cielo del modo White
      const skyParticles = Array.from({ length: 64 }, (_, i) => ({
        nx: ((i * 37.3 + 11) % 100) / 100,
        ny: 0.05 + ((i * 23.7 + 7) % 86) / 100,
        r: 0.9 + (i % 4) * 0.45,
        speed: 0.25 + (i % 5) * 0.14,
        phase: i * 1.13,
        hue: i % 3 === 0 ? "2, 132, 199" : i % 3 === 1 ? "124, 58, 237" : "15, 23, 42",
      }));

      const skyGlyphs = [
        { nx: 0.07, ny: 0.18, text: "∇·E = ρ/ε₀", col: "2, 132, 199" },
        { nx: 0.17, ny: 0.34, text: "33.4489° S · 70.6693° W", col: "15, 23, 42" },
        { nx: 0.09, ny: 0.56, text: "f(x,t) = Σ aₙ eⁱᵏˣ", col: "124, 58, 237" },
        { nx: 0.22, ny: 0.72, text: "0101 · 99.98%", col: "2, 132, 199" },
        { nx: 0.14, ny: 0.12, text: "Δt → 0.012s", col: "71, 85, 105" },
        { nx: 0.28, ny: 0.21, text: "∫ Ω dV", col: "124, 58, 237" },
        { nx: 0.05, ny: 0.76, text: "MOD:26 // APP:18", col: "15, 23, 42" },
        { nx: 0.74, ny: 0.19, text: "P(x|θ) = ∏ pᵢ", col: "124, 58, 237" },
        { nx: 0.87, ny: 0.14, text: "λ = 480nm", col: "2, 132, 199" },
        { nx: 0.83, ny: 0.35, text: "SYNC // v1.04", col: "15, 23, 42" },
        { nx: 0.91, ny: 0.54, text: "∑ N = 18 · LIVE", col: "2, 132, 199" },
        { nx: 0.77, ny: 0.69, text: "∂u/∂t = α∇²u", col: "124, 58, 237" },
        { nx: 0.89, ny: 0.78, text: "0x7F · +42.8", col: "71, 85, 105" },
        { nx: 0.69, ny: 0.11, text: "φ = 1.6180", col: "2, 132, 199" },
      ];

      // detailed = true solo dentro de la lente de datos: en el blanco inicial quedan únicamente partículas tenues
      function drawWhiteSkyTelemetry(coastY: number, detailed: boolean) {
        ctx.save();
        const pxShift = mouse.x * 14;

        // 1. Partículas finas flotando en el cielo + micro-vectores entre vecinas
        const pts: { x: number; y: number; hue: string; r: number; a: number }[] = [];
        for (const p of skyParticles) {
          const x = p.nx * w + Math.sin(t * p.speed + p.phase) * 14 - pxShift * (0.4 + p.ny * 0.6);
          const y = p.ny * (coastY - 22) + Math.cos(t * p.speed * 0.8 + p.phase) * 8;
          // Atenuar suavemente justo detrás del bloque central de texto
          const dx = (x - textSafe.cx) / Math.max(1, textSafe.rx * 0.92);
          const dy = (y - textSafe.cy) / Math.max(1, textSafe.ry * 0.92);
          const d2 = dx * dx + dy * dy;
          // Piso de visibilidad: las partículas translúcidas no deben desaparecer al pasar por el texto
          const safeAtten = d2 < 1 ? 0.4 : Math.min(1, 0.45 + (d2 - 1) * 0.55);
          const a = (0.3 + 0.2 * Math.sin(t * 1.6 + p.phase)) * safeAtten;
          pts.push({ x, y, hue: p.hue, r: p.r, a });
        }

        // Líneas muy finas entre partículas cercanas (sensación de espacio de datos vivo)
        ctx.lineWidth = 0.6;
        const linkCount = detailed ? pts.length : 0;
        for (let i = 0; i < linkCount; i++) {
          for (let j = i + 1; j < Math.min(i + 12, pts.length); j++) {
            const dist = Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y);
            if (dist < 115) {
              const lineA = (1 - dist / 115) * Math.min(pts[i].a, pts[j].a) * 0.55;
              if (lineA > 0.015) {
                ctx.strokeStyle = `rgba(2, 132, 199, ${lineA.toFixed(3)})`;
                ctx.beginPath();
                ctx.moveTo(pts[i].x, pts[i].y);
                ctx.lineTo(pts[j].x, pts[j].y);
                ctx.stroke();
              }
            }
          }
        }

        for (const pt of pts) {
          ctx.fillStyle = `rgba(${pt.hue}, ${pt.a.toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
          ctx.fill();
        }

        // 2. Fórmulas matemáticas, coordenadas y números en distintos lugares del cielo
        ctx.font = "500 10.5px 'JetBrains Mono', monospace";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        if (detailed) skyGlyphs.forEach((g, idx) => {
          const gx = g.nx * w + Math.sin(t * 0.45 + idx * 1.4) * 9 - pxShift * 0.8;
          const gy = g.ny * (coastY - 28) + Math.cos(t * 0.55 + idx) * 6;
          const pulse = 0.72 + 0.28 * Math.sin(t * 1.3 + idx * 1.9);

          // Micro-cruz de registro junto a algunas coordenadas
          if (idx % 3 === 0) {
            ctx.strokeStyle = `rgba(${g.col}, ${(0.22 * pulse).toFixed(3)})`;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(gx - 3, gy - 11);
            ctx.lineTo(gx + 3, gy - 11);
            ctx.moveTo(gx, gy - 14);
            ctx.lineTo(gx, gy - 8);
            ctx.stroke();
          }

          ctx.fillStyle = `rgba(${g.col}, ${(0.28 * pulse).toFixed(3)})`;
          ctx.fillText(g.text, gx, gy);
        });
        ctx.restore();
      }

      // ─── CAPA 1: MUNDO ABSTRACTO DE DATOS (NUBES + PARTÍCULAS/MATEMÁTICAS + CORDILLERA + MAR 3D) ───
      // overlay = true: capa de datos translúcida encima del mundo a color (dentro de la lente), sin tapar el detalle
      type CityTower = {
        nx: number;
        bw: number;
        bh: number;
        style: "spire" | "slant" | "dome" | "twin" | "eco";
        accent: string;
      };

      // Catálogo compartido entre el mundo real a color y los planos transparentes del mundo de datos
      const CITY_TOWERS: CityTower[] = [
        // Lado DÍA (izquierda): más piezas en el borde, el centro queda para el estadio y la municipalidad
        { nx: 0.014, bw: 16, bh: 108, style: "spire", accent: "#38bdf8" },
        { nx: 0.035, bw: 18, bh: 96, style: "slant", accent: "#38bdf8" },
        { nx: 0.075, bw: 20, bh: 94, style: "eco", accent: "#34d399" },
        { nx: 0.12, bw: 20, bh: 88, style: "eco", accent: "#34d399" },
        { nx: 0.138, bw: 12, bh: 72, style: "dome", accent: "#7dd3fc" },
