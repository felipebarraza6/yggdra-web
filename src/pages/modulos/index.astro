---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allModuleIds, projectsForModule } from "../../lib/data";

const base = import.meta.env.BASE_URL;
const rows = allModuleIds.map((m) => ({
  id: m,
  apps: projectsForModule(m).length,
}));
---

<BaseLayout
  title="Módulos API — YARQ"
  description="Módulos de dominio de la arquitectura YARQ y las aplicaciones que los consumen."
>
  <section class="page-hero">
    <div class="wrap">
      <ul class="breadcrumbs">
        <li><a href={base}>Inicio</a> /</li>
        <li>Módulos</li>
      </ul>
      <p class="section-kicker">Contrato OpenAPI</p>
      <h1>Módulos de dominio</h1>
      <p style="color:var(--text-muted);max-width:42rem;margin:0;">
        Capacidades reutilizables expuestas por la API compartida. Cada módulo
        se habilita por organización según el plan y enlaza a las aplicaciones
        que lo consumen.
      </p>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap grid-cards">
      {
        rows.map((r) => (
          <a class="product-card glass glass--interactive" href={`${base}modulos/${encodeURIComponent(r.id)}/`}>
            <h3 style="font-family:var(--font-mono);font-size:1.05rem;">{r.id}</h3>
            <p class="meta" style="margin:0;">
              {r.apps} {r.apps === 1 ? "aplicación" : "aplicaciones"}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
