---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, publicOrg, publicLabel, publicCopy } from "../../lib/data";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Catálogo — YARQ"
  description="Catálogo público de aplicaciones y módulos que operan sobre la arquitectura YARQ y su fork Nereus API."
>
  <section class="page-hero">
    <div class="wrap">
      <ul class="breadcrumbs">
        <li><a href={base}>Inicio</a> /</li>
        <li>Catálogo</li>
      </ul>
      <p class="section-kicker">Catálogo</p>
      <h1>Aplicaciones del ecosistema</h1>
      <p style="color:var(--text-muted);max-width:42rem;margin:0;">
        Productos y servicios conectados a la plataforma YARQ y a su ecosistema
        derivado Nereus API. Cada ficha expone su estado, dominio y módulos de
        contrato.
      </p>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap grid-cards grid-cards--roomy">
      {
        projects.map((c) => (
          <a class="product-card glass glass--interactive product-card--headed" href={`${base}apps/${c.id}/`}>
            <header class="product-card__head">
              <span class="product-card__tag">{publicOrg(c.company)}</span>
              <span class="badge" data-status={c.statusLabel}>{c.statusLabel}</span>
            </header>
            <h3>{publicLabel(c)}</h3>
            {c.description && (
              <p class="meta" style="margin:0;">
                {publicCopy(c.description)}
              </p>
            )}
            <div class="modules">
              {c.modules.slice(0, 6).map((m) => (
                <span class="mod-chip">{m}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
