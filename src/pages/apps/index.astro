---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../lib/data";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Store — productos YARQ"
  description="Store público de productos que caminan con el equipo YARQ."
>
  <section class="page-hero">
    <div class="wrap">
      <ul class="breadcrumbs">
        <li><a href={base}>Inicio</a> /</li>
        <li>Store</li>
      </ul>
      <p class="section-kicker">Store</p>
      <h1>El catálogo vivo del equipo</h1>
      <p style="color:var(--text-muted);max-width:40rem;margin:0;">
        Aquí viven los productos — cada uno con su oficio y su organización.
        Los casos de la home muestran las organizaciones; el Store muestra cada
        pieza.
      </p>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap grid-cards grid-cards--roomy">
      {
        projects.map((c) => (
          <a class="product-card glass product-card--headed" href={`${base}apps/${c.id}/`}>
            <header class="product-card__head">
              <span class="product-card__tag">{c.company || "Ecosistema YARQ"}</span>
              <span class="badge" data-status={c.statusLabel}>{c.statusLabel}</span>
            </header>
            <h3>{c.product || c.name}</h3>
            {c.description && (
              <p class="meta" style="margin:0;">
                {c.description.replace(/Yggdra/gi, "YARQ")}
              </p>
            )}
            <div class="modules">
              {c.modules.slice(0, 6).map((m) => (
                <span class="mod-chip">{m}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
