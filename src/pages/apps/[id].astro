---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  projects,
  getProject,
  activityForModules,
  githubForProject,
  publicOrg,
  publicLabel,
  publicCopy,
} from "../../lib/data";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const project = getProject(id!);
if (!project) {
  throw new Error(`App no encontrada: ${id}`);
}

const base = import.meta.env.BASE_URL;
const related = activityForModules(project.modules, 10);
const gh = githubForProject(project);
const label = publicLabel(project);
const org = publicOrg(project.company);
const title = `${label} | YARQ`;
const description =
  publicCopy(project.description) ||
  `${label} opera sobre la arquitectura YARQ.`;

const mods = project.modules;
const svgH = Math.max(240, 56 + mods.length * 40);
---

<BaseLayout title={title} description={description}>
  <section class="page-hero product-identity">
    <div class="wrap">
      <ul class="breadcrumbs">
        <li><a href={base}>Inicio</a> /</li>
        <li><a href={`${base}apps/`}>Catálogo</a> /</li>
        <li>{label}</li>
      </ul>
      <div class="product-identity__banner glass">
        <div class="product-identity__mark" aria-hidden="true">
          <span>{label.slice(0, 2).toUpperCase()}</span>
        </div>
        <div>
          <p class="section-kicker">Ficha técnica</p>
          <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;">
            <h1 style="margin:0;">{label}</h1>
            <span class="badge" data-status={project.statusLabel}>{project.statusLabel}</span>
          </div>
          <p style="color:var(--text-muted);max-width:40rem;margin:0.75rem 0 0;">
            {description}
          </p>
          <p class="product-identity__org">
            Ecosistema: <strong>{org}</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap two-col">
      <article class="glass panel panel--headed">
        <header class="panel-head">
          <span class="panel-head__tag">Resumen</span>
          <h2>Datos generales</h2>
        </header>
        <dl style="margin:0;display:grid;gap:0.75rem;">
          <div>
            <dt style="color:var(--text-muted);font-size:0.85rem;">Ecosistema / Organización</dt>
            <dd style="margin:0;font-weight:600;">{org}</dd>
          </div>
          <div>
            <dt style="color:var(--text-muted);font-size:0.85rem;">Estado</dt>
            <dd style="margin:0;">{project.statusLabel}</dd>
          </div>
          <div>
            <dt style="color:var(--text-muted);font-size:0.85rem;">Integración</dt>
            <dd style="margin:0;">{publicCopy(project.contract?.label) || "Consumo del contrato público"}</dd>
          </div>
          {
            project.domains?.length > 0 && (
              <div>
                <dt style="color:var(--text-muted);font-size:0.85rem;">Dominios públicos</dt>
                <dd style="margin:0;">
                  <ul style="margin:0;padding:0;list-style:none;">
                    {project.domains.map((d) => (
                      <li>
                        <a href={`https://${d}`} rel="noopener noreferrer" target="_blank">{d}</a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </article>

      <article class="glass panel panel--headed">
        <header class="panel-head">
          <span class="panel-head__tag">Contrato</span>
          <h2>Módulos consumidos</h2>
        </header>
        <div class="diagram-wrap space-diagram">
          <svg class="diagram" viewBox={`0 0 400 ${svgH}`} role="img" aria-label={`Módulos usados por ${label}`}>
            <defs>
              <linearGradient id="nodeGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.18"></stop>
                <stop offset="100%" stop-color="#0284c7" stop-opacity="0.08"></stop>
              </linearGradient>
            </defs>
            <rect class="node-strong" x="16" y={svgH / 2 - 28} width="130" height="56" rx="14" fill="url(#nodeGrad)"></rect>
            <text x="81" y={svgH / 2 + 5} text-anchor="middle" font-size="12" font-weight="700">
              {label.slice(0, 16)}
            </text>
            {
              mods.map((m, i) => {
                const y = 32 + i * 40;
                return (
                  <g>
                    <path class="edge" d={`M146 ${svgH / 2} L210 ${y + 14}`}></path>
                    <a href={`${base}modulos/${encodeURIComponent(m)}/`}>
                      <rect class="node" x="210" y={y} width="160" height="32" rx="10"></rect>
                      <text x="290" y={y + 20} text-anchor="middle" font-size="11">{m}</text>
                    </a>
                  </g>
                );
              })
            }
          </svg>
        </div>
        {
          mods.length === 0 && (
            <p style="color:var(--text-muted);margin:0;">Módulos en definición.</p>
          )
        }
      </article>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>Estilo de contrato</h2>
        <p>Integración declarada en el inventario público — sin exponer rutas internas.</p>
      </div>
      <div class="glass panel">
        <p style="margin:0;">
          <strong>{project.contract?.style}</strong>
          {" — "}
          {publicCopy(project.contract?.label)}
        </p>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section>
        <div class="wrap">
          <div class="section-head">
            <h2>Actividad relacionada</h2>
            <p>Hitos públicos recientes en los módulos que consume esta aplicación.</p>
          </div>
          <ol class="timeline">
            {related.map((item) => (
              <li>
                <time datetime={item.date}>{item.date}</time>
                <p class="summary">{publicCopy(item.summary)}</p>
                <a class="mod-chip" href={`${base}modulos/${encodeURIComponent(item.module)}/`}>
                  {item.module}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    gh && (
      <section>
        <div class="wrap">
          <div class="section-head">
            <h2>Repositorio público</h2>
            <p>Señal sincronizada desde GitHub.</p>
          </div>
          <div class="glass panel">
            <p style="margin:0 0 0.5rem;">
              <a href={gh.url} target="_blank" rel="noreferrer">{gh.fullName}</a>
            </p>
            {gh.description && (
              <p style="margin:0;color:var(--text-muted);">{publicCopy(gh.description)}</p>
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
