---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import Rune from "../components/Rune.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import ChangeFlowDiagram from "../components/ChangeFlowDiagram.astro";
import TenantDiagram from "../components/TenantDiagram.astro";
import ActivityCharts from "../components/ActivityCharts.astro";
import ModuleMap from "../components/ModuleMap.astro";
import { projects, modules, activity, counts } from "../lib/data";

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="section-kicker"><Rune name="algiz" /> Yggdra Platform</p>
        <h1>El árbol que sostiene muchas aplicaciones</h1>
        <p class="lede">
          Página explicativa de la plataforma y del oficio detrás: arquitectura
          multi-tenant, contratos OpenAPI, orquestación de cambios, CI/CD y el
          inventario vivo de las aplicaciones que la consumen o migran hacia ella.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={`${base}#tronco`}>Ver el tronco</a>
          <a class="btn btn-ghost" href={`${base}apps/`}>Explorar ramas</a>
        </div>
      </div>
      <div class="glass panel" style="padding:1.25rem;display:flex;justify-content:center;">
        <Logo size={260} />
      </div>
    </div>
  </section>

  <section id="raices">
    <div class="wrap">
      <div class="section-head">
        <p class="section-kicker"><Rune name="eihwaz" /> Raíces</p>
        <h2>Infraestructura y aislamiento</h2>
        <p>
          Las raíces sostienen el núcleo: identidad, datos y límites de tenant.
          Cada organización opera con sucursales aisladas sobre el mismo contrato.
        </p>
      </div>
      <TenantDiagram />
      <div class="glass panel stats-panel" style="margin-top:1rem;">
        <div>
          <div class="num">{counts.total}</div>
          <div class="lbl">apps consumidoras</div>
        </div>
        <div>
          <div class="num">{counts.active}</div>
          <div class="lbl">activas</div>
        </div>
        <div>
          <div class="num" style="color:var(--warn);">{counts.migrating}</div>
          <div class="lbl">en migración</div>
        </div>
        <div>
          <div class="num">{counts.modules}</div>
          <div class="lbl">módulos</div>
        </div>
      </div>
    </div>
  </section>

  <section id="tronco">
    <div class="wrap">
      <div class="section-head">
        <p class="section-kicker"><Rune name="ansuz" /> Tronco</p>
        <h2>API, módulos y contrato</h2>
        <p>
          El tronco es la capa compartida: módulos reutilizables expuestos por
          un contrato OpenAPI. Las aplicaciones no reinventan el dominio; lo
          consumen con tipado, proxy o integración planificada.
        </p>
      </div>
      <ArchitectureDiagram />
      <div class="model-points" style="margin-top:1rem;">
        <article class="glass panel">
          <h3>Multi-tenant</h3>
          <p>Organización y sucursal como unidades de aislamiento.</p>
        </article>
        <article class="glass panel">
          <h3>Módulos</h3>
          <p>Cuentas, ventas, finanzas, telemetría y más, según cada rama.</p>
        </article>
        <article class="glass panel">
          <h3>OpenAPI</h3>
          <p>Contrato estable entre plataforma y aplicaciones.</p>
        </article>
        <article class="glass panel">
          <h3>Observabilidad</h3>
          <p>Impacto de cada cambio medido contra el mapa de consumidores.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="ramas">
    <div class="wrap">
      <div class="section-head">
        <p class="section-kicker"><Rune name="raidho" /> Ramas</p>
        <h2>Mapa app ↔ módulos</h2>
        <p>
          Cada rama es una aplicación que se apoya en parte del tronco.
          La matriz y el grafo muestran esa relación; cada ficha enlaza a su página.
        </p>
      </div>
      <ModuleMap consumers={projects} modules={modules} base={base} />
      <p style="margin-top:1rem;">
        <a class="btn btn-ghost" href={`${base}apps/`}>Ver todas las aplicaciones</a>
        <a class="btn btn-ghost" href={`${base}modulos/`} style="margin-left:0.5rem;">Ver módulos</a>
      </p>
    </div>
  </section>

  <section id="nornas">
    <div class="wrap">
      <div class="section-head">
        <p class="section-kicker"><Rune name="sowilo" /> Nornas</p>
        <h2>Orquestación e impacto</h2>
        <p>
          Antes de llegar a producción, cada cambio se lee contra el destino
          de las ramas: qué módulos toca y qué aplicaciones deben ajustarse.
        </p>
      </div>
      <ChangeFlowDiagram />
      <div class="steps" style="margin-top:1rem;">
        <article class="step glass panel">
          <h3>Reporte automático</h3>
          <p>El pull request genera impacto sobre las apps consumidoras de los módulos afectados.</p>
        </article>
        <article class="step glass panel">
          <h3>Ajustes por rama</h3>
          <p>Se coordinan contrato, tipado o interfaz según la severidad del reporte.</p>
        </article>
        <article class="step glass panel">
          <h3>Promoción conjunta</h3>
          <p>Plataforma y aplicaciones avanzan juntas cuando el impacto está cubierto.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="bifrost">
    <div class="wrap">
      <div class="section-head">
        <p class="section-kicker"><Rune name="algiz" /> Bifröst</p>
        <h2>Integraciones, despliegue y actividad</h2>
        <p>
          El puente entre cambio y producción: CI/CD continuo y un registro
          público de avances de alto nivel, agrupados por módulo y por semana.
        </p>
      </div>
      <ActivityCharts items={activity} />
      <div class="glass panel" style="margin-top:1rem;">
        <h3 style="margin:0 0 1rem;font-family:var(--font-display);font-size:1.1rem;">Avances recientes</h3>
        <ol class="timeline">
          {
            activity.slice(0, 12).map((item) => (
              <li>
                <time datetime={item.date}>{item.date}</time>
                <p class="summary">{item.summary}</p>
                <a class="mod-chip" href={`${base}modulos/${encodeURIComponent(item.module)}/`}>{item.module}</a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2>Aplicaciones destacadas</h2>
        <p>Selección del inventario público. Cada ficha abre el detalle de módulos y contrato.</p>
      </div>
      <div class="grid-cards">
        {
          projects.filter((c) => c.status === "active").slice(0, 6).map((c) => (
            <a class="product-card glass" href={`${base}apps/${c.id}/`}>
              <div style="display:flex;justify-content:space-between;gap:0.5rem;align-items:flex-start;">
                <h3>{c.product || c.name}</h3>
                <span class="badge" data-status={c.statusLabel}>{c.statusLabel}</span>
              </div>
              <p class="meta">
                {c.company ? <>Cliente: <strong style="color:var(--text);">{c.company}</strong></> : <span>Cliente por confirmar</span>}
              </p>
              {c.description && <p class="meta" style="margin:0;">{c.description}</p>}
              <div class="modules">
                {c.modules.slice(0, 6).map((m) => <span class="mod-chip">{m}</span>)}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
