---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModuleMap from "../components/ModuleMap.astro";
import consumersData from "../../data/consumers.public.json";
import activityData from "../../data/activity.json";

const consumers = consumersData.consumers;
const modules = consumersData.modules;
const activity = activityData.items;

const counts = {
  total: consumers.length,
  active: consumers.filter((c) => c.status === "active").length,
  migrating: consumers.filter((c) => c.status === "migrating").length,
  legacy: consumers.filter((c) => c.status === "legacy").length,
  modules: modules.length,
};

const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-inner">
      <h1>Yggdra</h1>
      <p class="lede">
        Plataforma backend transversal multi-tenant: un núcleo compartido,
        módulos reutilizables y muchas aplicaciones sobre el mismo contrato.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${base}#mapa`}>Ver mapa de módulos</a>
        <a class="btn btn-ghost" href={`${base}#orquestacion`}>Cómo orquestamos</a>
      </div>
    </div>
  </section>

  <section id="modelo">
    <div class="wrap">
      <div class="section-head">
        <h2>Modelo de plataforma</h2>
        <p>
          Yggdra concentra la lógica de negocio en un backend multi-tenant con
          aislamiento por organización y sucursal. Las aplicaciones consumen
          módulos reutilizables a través de un contrato OpenAPI versionado,
          con orquestación de cambios y despliegue continuo.
        </p>
      </div>
      <div class="panel model-points" role="list">
        <div role="listitem">
          <h3>Multi-tenant</h3>
          <p>Aislamiento por organización y sucursal en un mismo núcleo.</p>
        </div>
        <div role="listitem">
          <h3>Módulos reutilizables</h3>
          <p>Cuentas, sucursales, ventas, finanzas, telemetría y más, según cada producto.</p>
        </div>
        <div role="listitem">
          <h3>Contrato OpenAPI</h3>
          <p>Interfaz estable entre el backend y las aplicaciones consumidoras.</p>
        </div>
        <div role="listitem">
          <h3>Despliegue continuo</h3>
          <p>Cambios orquestados con reporte de impacto y promoción coordinada.</p>
        </div>
      </div>
      <div class="panel stats-panel" style="margin-top:1rem;display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));text-align:center;">
        <div>
          <div style="font-family:var(--font-display);font-size:2rem;color:var(--accent-strong);">{counts.total}</div>
          <div style="color:var(--text-muted);font-size:0.9rem;">apps consumidoras</div>
        </div>
        <div>
          <div style="font-family:var(--font-display);font-size:2rem;color:var(--accent-strong);">{counts.active}</div>
          <div style="color:var(--text-muted);font-size:0.9rem;">activas</div>
        </div>
        <div>
          <div style="font-family:var(--font-display);font-size:2rem;color:var(--warn);">{counts.migrating}</div>
          <div style="color:var(--text-muted);font-size:0.9rem;">en migración</div>
        </div>
        <div>
          <div style="font-family:var(--font-display);font-size:2rem;color:var(--accent-strong);">{counts.modules}</div>
          <div style="color:var(--text-muted);font-size:0.9rem;">módulos</div>
        </div>
      </div>
    </div>
  </section>

  <section id="mapa">
    <div class="wrap">
      <div class="section-head">
        <h2>Mapa app ↔ módulos</h2>
        <p>
          Relación entre cada aplicación consumidora y los módulos de Yggdra
          que utiliza. Disponible como matriz o grafo, con filtros por nombre
          y estado.
        </p>
      </div>
      <ModuleMap consumers={consumers} modules={modules} />
    </div>
  </section>

  <section id="productos">
    <div class="wrap">
      <div class="section-head">
        <h2>Productos y clientes</h2>
        <p>
          Inventario público de productos que operan sobre Yggdra: cliente
          visible cuando corresponde, estado operativo y módulos consumidos.
        </p>
      </div>
      <div class="grid-cards">
        {
          consumers.map((c) => (
            <article class="product-card" id={`app-${c.id}`}>
              <div style="display:flex;justify-content:space-between;gap:0.5rem;align-items:flex-start;">
                <h3>{c.product || c.name}</h3>
                <span class="badge" data-status={c.statusLabel}>{c.statusLabel}</span>
              </div>
              <p class="meta">
                {c.company ? (
                  <>
                    Cliente: <strong style="color:var(--text);font-weight:600;">{c.company}</strong>
                  </>
                ) : (
                  <span>Cliente por confirmar</span>
                )}
              </p>
              {c.description && <p class="meta" style="margin:0;">{c.description}</p>}
              {c.domains?.length > 0 && (
                <ul class="domains">
                  {c.domains.map((d) => (
                    <li>
                      <a href={`https://${d}`} rel="noopener noreferrer" target="_blank">
                        {d}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              <div class="modules" aria-label="Módulos">
                {c.modules.length ? (
                  c.modules.map((m) => <span class="mod-chip">{m}</span>)
                ) : (
                  <span class="meta">Módulos en definición (migración)</span>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="avances">
    <div class="wrap">
      <div class="section-head">
        <h2>Avances recientes</h2>
        <p>
          Resumen público de alto nivel sobre cambios en la plataforma.
          Sin hashes ni detalle interno.
        </p>
      </div>
      <ol class="timeline">
        {
          activity.map((item) => (
            <li>
              <time datetime={item.date}>{item.date}</time>
              <p class="summary">{item.summary}</p>
              <span class="mod-chip">{item.module}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="orquestacion">
    <div class="wrap">
      <div class="section-head">
        <h2>Cómo orquestamos</h2>
        <p>
          Cada cambio en el backend se evalúa contra el mapa de consumidores
          antes de llegar a producción, con despliegue continuo coordinado.
        </p>
      </div>
      <div class="steps">
        <article class="step">
          <h3>Reporte de impacto</h3>
          <p>
            Cada pull request del backend genera un reporte automático sobre
            las aplicaciones que usan los módulos afectados.
          </p>
        </article>
        <article class="step">
          <h3>Ajustes por aplicación</h3>
          <p>
            Se coordinan cambios de contrato, tipado o interfaz en cada
            producto impactado, según la severidad del reporte.
          </p>
        </article>
        <article class="step">
          <h3>Promoción conjunta</h3>
          <p>
            Backend y aplicaciones se promueven en conjunto cuando el impacto
            está cubierto, manteniendo la coherencia del despliegue continuo.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
